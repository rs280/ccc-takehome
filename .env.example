# Local Ollama (default, free, no key). Create the model first: ollama create incident-qwen3 -f ollama/Modelfile
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=incident-qwen3
LLM_API_KEY=ollama
LLM_REASONING_EFFORT=none
LLM_MAX_CONCURRENCY=1

# Groq free tier (fast, needs a free key from console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_...
# LLM_REASONING_EFFORT=low
# LLM_MAX_CONCURRENCY=4
# LLM_MAX_RETRIES=8

# Gemini free tier (key from aistudio.google.com):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...
# LLM_REASONING_EFFORT=
# LLM_MAX_CONCURRENCY=4

# Connect to a running MCP server over Streamable HTTP instead of spawning one over stdio:
# MCP_URL=http://localhost:8000/mcp
